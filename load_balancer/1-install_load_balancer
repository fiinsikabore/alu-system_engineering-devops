#!/usr/bin/env bash
# Installs and configures HAProxy to load balance web-01 and web-02 with roundrobin

apt-get update -y
apt-get install -y haproxy

echo "ENABLED=1" >> /etc/default/haproxy

cat >> /etc/haproxy/haproxy.cfg << EOF

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    balance roundrobin
    server 7309-web-01 35.178.114.160:80 check
    server 7309-web-02 13.40.175.187:80 check
EOF

service haproxy restart
